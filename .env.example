# Copy to .env and replace every change-me value. Never commit .env.

# Postgres (read by the postgres container)
POSTGRES_USER=genealogy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genealogy

# Must match the three values above; "postgres" is the Compose service name.
DATABASE_URL=postgresql+psycopg://genealogy:change-me@postgres:5432/genealogy

# MCP server
MCP_TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Documents
CORPUS_ROOT=/corpus
BLOB_BACKEND=local

# Embeddings. Changing the model or dimension requires a migration and a full re-embed.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=16
SENTENCE_TRANSFORMERS_HOME=/models

# OCR, applied only to pages with fewer than OCR_MIN_CHARS characters of text
OCR_LANGUAGES=por+eng
OCR_MIN_CHARS=40

# Search limits
SEARCH_MAX_LIMIT=10
SEARCH_MAX_CHARS=4000
